SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
API_TOKEN=
PORT=3000
LOG_LEVEL=info

# Decodo residential proxy (optional — without it the worker uses the box's
# datacenter IP, which most prospect-site WAFs block; fine for local smoke
# tests against permissive forms like httpbin only)
DECODO_USERNAME=
DECODO_PASSWORD=
DECODO_HOST=gate.decodo.com
DECODO_PORT=10001

# Anthropic for LLM field-mapping during discovery (optional — without it the
# worker uses heuristic-only mapping, which fails on opaque field names like
# wpforms[fields][N] or input_3 that plugin-driven forms produce)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
