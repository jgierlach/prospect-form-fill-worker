SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
API_TOKEN=
PORT=3000
LOG_LEVEL=info

# Decodo residential proxy (optional — without it the worker uses the box's
# datacenter IP, which most prospect-site WAFs block; fine for local smoke
# tests against permissive forms like httpbin only)
DECODO_USERNAME=
DECODO_PASSWORD=
DECODO_HOST=gate.decodo.com
DECODO_PORT=10001
